# Supabase — copier vers .env et remplir (NE JAMAIS committer .env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Clé publishable (nouveau format, exposée côté client — équivalent anon)
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Clé secrète (nouveau format, bypass RLS — backend/scripts UNIQUEMENT)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Mot de passe par défaut pour les scripts de seed (scripts/*.mjs)
SEED_DEFAULT_PASSWORD=

# App
NUXT_PUBLIC_GEOFENCE_RADIUS=300
NUXT_PUBLIC_GPS_MIN_ACCURACY=10
